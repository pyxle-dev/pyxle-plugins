"""Alembic environment for a pyxle-db app (async). Generated by `pyxle-db alembic-init`.

The database URL and target metadata come from the project's pyxle.config.json +
.env via pyxle-db, so Alembic and the running app always agree on the database
and the schema. Do not hard-code a connection string here.
"""

from __future__ import annotations

import asyncio
from logging.config import fileConfig

from alembic import context
from sqlalchemy import pool
from sqlalchemy.ext.asyncio import create_async_engine

from pyxle_db.orm.alembic.runtime import resolve_alembic_runtime

config = context.config
if config.config_file_name is not None:
    fileConfig(config.config_file_name)

_runtime = resolve_alembic_runtime()
target_metadata = _runtime.metadata


def run_migrations_offline() -> None:
    """Emit SQL to stdout without a live connection (``--sql``)."""
    context.configure(
        url=str(_runtime.url),
        target_metadata=target_metadata,
        literal_binds=True,
        dialect_opts={"paramstyle": "named"},
        compare_type=True,
        render_as_batch=_runtime.is_sqlite,
    )
    with context.begin_transaction():
        context.run_migrations()


def _do_run_migrations(connection) -> None:
    context.configure(
        connection=connection,
        target_metadata=target_metadata,
        compare_type=True,
        # SQLite can't ALTER most things — batch mode rewrites tables instead.
        render_as_batch=_runtime.is_sqlite,
    )
    with context.begin_transaction():
        context.run_migrations()


async def run_migrations_online() -> None:
    engine = create_async_engine(_runtime.url, poolclass=pool.NullPool)
    try:
        async with engine.connect() as connection:
            await connection.run_sync(_do_run_migrations)
    finally:
        await engine.dispose()


if context.is_offline_mode():
    run_migrations_offline()
else:
    asyncio.run(run_migrations_online())
